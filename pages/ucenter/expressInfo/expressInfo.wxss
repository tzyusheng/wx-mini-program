page {
  height: 100%;
  width: 100%;
  background: #f4f4f4;
}

.container {
  background: #f4f4f4;
  min-height: 100%;
  width: 100%;
  padding-bottom: 40rpx;
}

.topExpress {
  width: 710rpx;
  min-height: 155rpx;
  background: #fff;
  margin: 10rpx auto;
  display: flex;
  border-radius: 10rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

.topExpress-left {
  width: 120rpx;
  height: 100rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  margin-right: 16rpx;
}

.topExpress-left .avatar {
  height: 100rpx;
  width: 100rpx;
  border-radius: 50%;
}

.topExpress-right {
  font-size: 26rpx;
  color: #333;
  display: flex;
  justify-content: flex-start;
  flex-direction: column;
  align-items: flex-start;
  flex: 1;
  min-width: 0;
}

.topExpress-right-top {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 6rpx;
}

.topExpress-right-middle {
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
  word-break: break-all;
  overflow-wrap: break-word;
}

.topExpress-right-bottom {
  font-size: 24rpx;
  color: #666;
}

.expressRecord {
  width: 710rpx;
  padding: 30rpx 16rpx 60rpx;
  background: #fff;
  margin: 16rpx auto;
  border-radius: 10rpx;
  box-sizing: border-box;
}

.expressRecord-getAddress {
  width: 100%;
  font-size: 28rpx;
  color: #999;
  display: flex;
}

.expressRecord-top {
  width: 100%;
  display: flex;
  justify-content: flex-start;
  align-items: center;
  padding-left: 30rpx;
}

.getAddress-icon {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.finish {
  background: #45dd09;
}
.unfinish {
  background: #f7f303;
}
.getAddress-text {
  margin-left: 16rpx;
  font-size: 28rpx;
}

.noReach-online-top-close {
  width: 1rpx;
  height: 40rpx;
  background: #ddd;
  margin-left: 42rpx;
}

.expressRecord-single-close {
  width: 100%;
  min-height: 100rpx;
  display: flex;
  justify-content: flex-start;
  align-items: flex-start;
  position: relative;
  padding: 20rpx 0;
}

.expressRecord-single-noReach-online-top-close {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 84rpx;
  flex-shrink: 0;
}

.online-top-closing {
  width: 2rpx;
  height: 40rpx;
  background: #ddd;
}

.online-top-close {
  width: 2rpx;
  height: 40rpx;
  background: #ddd;
}

.dot-close {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: rgb(21, 216, 4);
  flex-shrink: 0;
  margin: 4rpx 0;
}

.online-bottom {
  width: 2rpx;
  flex: 1;
  min-height: 30rpx;
  background: #ddd;
}

.online-bottom-start {
  width: 2rpx;
  height: 40rpx;
}

.expressRecord-text {
  flex: 1;
  min-width: 0;
  padding-left: 16rpx;
  padding-right: 10rpx;
}

.expressRecord-statusing {
  font-size: 26rpx;
  color: #999;
}

.expressRecord-status-address {
  font-size: 26rpx;
  color: #333;
  line-height: 1.6;
  word-break: break-all;
}

.expressRecord-status {
  font-size: 30rpx;
  color: #999;
}

.expressRecord-date {
  width: 130rpx;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  flex-direction: column;
  color: #999;
  flex-shrink: 0;
  padding-top: 2rpx;
}

.expressRecord-date-text {
  font-size: 22rpx;
  white-space: nowrap;
}

.expressRecord-date-time {
  font-size: 22rpx;
  white-space: nowrap;
}