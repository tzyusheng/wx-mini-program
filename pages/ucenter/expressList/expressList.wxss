page {
  height: 100%;
  width: 100%;
  background: #f5f5f5;
}

.container {
  background: #f5f5f5;
  min-height: 100%;
  padding-bottom: 40rpx;
}

/* 概览栏 */
.summary-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: #fff;
  padding: 30rpx 20rpx;
  margin-bottom: 16rpx;
}

.summary-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.summary-num {
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
}

.summary-num.active {
  color: #fa8919;
}

.summary-num.finish {
  color: #45dd09;
}

.summary-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.summary-divider {
  width: 1rpx;
  height: 60rpx;
  background: #eee;
}

/* 快递列表 */
.express-list {
  padding: 0 20rpx;
}

.express-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
}

/* 卡片头部 */
.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 20rpx;
}

.card-header-left {
  display: flex;
  align-items: center;
}

.express-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 12rpx;
}

.express-company {
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
}

.card-status {
  font-size: 26rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  color: #999;
  background: #f5f5f5;
}

.card-status.active {
  color: #fa8919;
  background: #fff7e6;
}

.card-status.finish {
  color: #45dd09;
  background: #f0ffe6;
}

/* 卡片信息行 */
.card-info {
  display: flex;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.card-info .label {
  font-size: 26rpx;
  color: #999;
  flex-shrink: 0;
}

.card-info .value {
  font-size: 26rpx;
  color: #333;
  word-break: break-all;
}

/* 最新轨迹 */
.card-trace {
  display: flex;
  align-items: flex-start;
  margin-top: 16rpx;
  padding: 16rpx;
  background: #f9f9f9;
  border-radius: 10rpx;
}

.trace-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #fa8919;
  margin-top: 8rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.trace-dot.finish {
  background: #45dd09;
}

.trace-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  flex: 1;
}

.card-trace-time {
  font-size: 24rpx;
  color: #bbb;
  margin-top: 8rpx;
  text-align: right;
}

/* 查看详情 */
.card-footer {
  display: flex;
  justify-content: flex-end;
  margin-top: 20rpx;
}

.btn-detail {
  font-size: 26rpx;
  color: #999;
  padding: 8rpx 20rpx;
  border: 1rpx solid #ddd;
  border-radius: 30rpx;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-img {
  width: 240rpx;
  height: 240rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
  margin-top: 30rpx;
}

.empty-tip {
  font-size: 24rpx;
  color: #bbb;
  margin-top: 12rpx;
}
