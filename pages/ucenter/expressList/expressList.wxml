<view class="container">
  <!-- 头部概览 -->
  <view class="summary-bar">
    <view class="summary-item">
      <view class="summary-num">{{expressList.length}}</view>
      <view class="summary-label">总运单</view>
    </view>
    <view class="summary-divider"></view>
    <view class="summary-item">
      <view class="summary-num active">{{inTransitCount}}</view>
      <view class="summary-label">运输中</view>
    </view>
    <view class="summary-divider"></view>
    <view class="summary-item">
      <view class="summary-num finish">{{deliveredCount}}</view>
      <view class="summary-label">已签收</view>
    </view>
  </view>

  <!-- 快递列表 -->
  <view class="express-list" wx:if="{{expressList.length > 0}}">
    <view class="express-card" wx:for="{{expressList}}" wx:key="id" bindtap="goDetail" data-order-id="{{item.orderId}}">
      <!-- 头部 -->
      <view class="card-header">
        <view class="card-header-left">
          <image class="express-icon" src="/static/images/dfh.png"></image>
          <text class="express-company">{{item.shipperName || '物流公司'}}</text>
        </view>
        <view class="card-status {{item.state == 3 ? 'finish' : item.state == 2 ? 'active' : ''}}">
          {{item.stateText}}
        </view>
      </view>
      <!-- 运单号 -->
      <view class="card-info">
        <text class="label">运单号：</text>
        <text class="value">{{item.shipperCode || '暂无'}}</text>
      </view>
      <!-- 订单号 -->
      <view class="card-info">
        <text class="label">订单编号：</text>
        <text class="value">{{item.orderSn || '暂无'}}</text>
      </view>
      <!-- 收货地址 -->
      <view class="card-info">
        <text class="label">收货地址：</text>
        <text class="value">{{item.address || '暂无'}}</text>
      </view>
      <!-- 最新轨迹（隐藏：需要时把 false 改为 true，原条件为 item.latestTrace） -->
      <view class="card-trace" wx:if="{{false}}">
        <view class="trace-dot {{item.state == 3 ? 'finish' : ''}}"></view>
        <view class="trace-text">{{item.latestTrace}}</view>
      </view>
      <view class="card-trace-time" wx:if="{{false}}">{{item.latestTime}}</view>
      <!-- 查看详情（隐藏：需要时把 false 改为 true） -->
      <view class="card-footer" wx:if="{{false}}">
        <view class="btn-detail">查看物流详情 ></view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:if="{{expressList.length === 0 && !loading}}">
    <image class="empty-img" src="/static/images/noCart.png"></image>
    <view class="empty-text">暂无快递信息</view>
    <view class="empty-tip">您的订单发货后将在这里显示</view>
  </view>
</view>
