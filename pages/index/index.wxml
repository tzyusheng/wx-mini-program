<!--index.wxml-->
<view class="container">
 <view class="search">
    <navigator url="/pages/search/search" class="input jhx_bg1">
      <image class="icon"></image>
      <text class="txt jhx_f1">商品搜索</text>
    </navigator>
  </view>
  <swiper class="banner" indicator-dots="true" autoplay="true" interval="3000" duration="1000">
    <swiper-item wx:for="{{banner}}" wx:key="id">
      <!-- <navigator url="{{item.link}}"> -->
      <image src="{{item.url}}" background-size="cover"></image>
      <!-- </navigator> -->
    </swiper-item>
  </swiper>
  <view class="purchase-notes">
    <view class="notes-header">
      <text class="notes-icon">📋</text>
      <text class="notes-title">购买事项</text>
    </view>
    <view class="notes-list">
      <view class="notes-item">
        <text class="notes-dot">●</text>
        <text class="notes-text">下单前请仔细核对商品规格、数量及收货地址</text>
      </view>
      <view class="notes-item">
        <text class="notes-dot">●</text>
        <text class="notes-text">商品拍下后请尽快付款，超时订单将自动取消</text>
      </view>
      <view class="notes-item">
        <text class="notes-dot">●</text>
        <text class="notes-text">如遇商品质量问题，请在签收后24小时内联系客服</text>
      </view>
      <view class="notes-item">
        <text class="notes-dot">●</text>
        <text class="notes-text">客服工作时间：周一至周五 9:00-18:00</text>
      </view>
      <view class="notes-item">
        <text class="notes-dot">●</text>
        <text class="notes-text">满88元包邮，未满88元需支付8元运费</text>
      </view>
      <view class="notes-item">
        <text class="notes-dot">●</text>
        <text class="notes-text">下单后一般48小时内发货，节假日顺延</text>
      </view>
      <view class="notes-item">
        <text class="notes-dot">●</text>
        <text class="notes-text">支持7天无理由退换货，需保证商品完好</text>
      </view>
      <view class="notes-item">
        <text class="notes-dot">●</text>
        <text class="notes-text">退换货运费由买家承担，质量问题除外</text>
      </view>
      <view class="notes-item">
        <text class="notes-dot">●</text>
        <text class="notes-text">如有任何疑问，请先联系客服确认后再下单</text>
      </view>
    </view>
  </view>
