<view class="container">
  <view class="search">
    <navigator url="/pages/search/search" class="input jhx_bg1">
      <image class="icon"></image>
      <text class="txt jhx_f1">商品搜索</text>
    </navigator>
  </view>
  <view class="catalog">
    <scroll-view class="nav" scroll-y="true">
      <view 
        class="nav-item {{ currentId == item.id ? 'active' : ''}}" 
        wx:for="{{categoryList}}" 
        wx:key="id" 
        data-id="{{item.id}}" 
        bindtap="switchCate"
      >{{item.name}}</view>
    </scroll-view>
    <scroll-view class="goods-area {{cartGoodsCount > 0 ? 'has-cart-bar' : ''}}" scroll-y="true" bindscrolltolower="onReachBottom">
      <view class="goods-list">
        <view class="goods-item" wx:for="{{goodsList}}" wx:key="id">
          <navigator url="/pages/goods/goods?id={{item.id}}" class="img-box">
            <image class="img" src="{{item.picUrl}}" mode="aspectFill"></image>
          </navigator>
          <view class="info-box">
            <navigator url="/pages/goods/goods?id={{item.id}}" class="name">{{item.name}}</navigator>
            <view class="tags" wx:if="{{item.isHot || item.isNew}}">
              <text class="tag tag-hot" wx:if="{{item.isHot}}">热卖</text>
              <text class="tag tag-new" wx:if="{{item.isNew}}">新品</text>
            </view>
            <view class="bottom-row">
              <text class="price jhx_f8">￥{{item.retailPrice}}</text>
              <view class="btn-cart" bindtap="openSpecPopup" data-id="{{item.id}}">
                <text class="btn-cart-icon iconfont icon-gouwuche1"></text>
              </view>
            </view>
          </view>
        </view>
      </view>
      <view class="loading-more" wx:if="{{loading}}">加载中...</view>
      <view class="no-more" wx:if="{{noMore}}">没有更多了</view>
    </scroll-view>
  </view>

  <!-- 底部购物车栏 -->
  <view class="bottom-cart-bar" bindtap="openCartPage" wx:if="{{cartGoodsCount > 0}}">
    <view class="bottom-cart-icon-box">
      <text class="bottom-cart-count">{{cartGoodsCount}}</text>
      <text class="iconfont icon-gouwuche1 bottom-cart-icon"></text>
    </view>
    <view class="bottom-cart-text">共{{cartGoodsCount}}件商品</view>
    <view class="bottom-cart-arrow iconfont icon-xiangyou"></view>
  </view>

  <!-- 规格选择弹窗 -->
  <view class="attr-pop-box" hidden="{{!openAttr}}" bindtap="closeAttr">
    <view class="attr-pop" catchtap="noop">
      <view class="close" bindtap="closeAttr">
        <image class="icon" src="/static/images/icon_close.png"></image>
      </view>
      <view class="img-info">
        <image class="img" src="{{currentGoods.picUrl}}"></image>
        <view class="info">
          <view class="c">
            <view class="p">价格：￥{{checkedSpecPrice}}</view>
            <view class="a">{{tmpSpecText}}</view>
          </view>
        </view>
      </view>
      <view class="spec-con">
        <view class="spec-item" wx:for="{{specificationList}}" wx:key="name">
          <view class="name">{{item.name}}</view>
          <view class="values">
            <view class="value {{vitem.checked ? 'selected' : ''}}" bindtap="clickSkuValue" wx:for="{{item.valueList}}" wx:for-item="vitem" wx:key="{{vitem.id}}" data-value-id="{{vitem.id}}" data-name="{{vitem.specification}}">{{vitem.value}}</view>
          </view>
        </view>
        <view class="number-item">
          <view class="name">数量</view>
          <view class="selnum">
            <view class="cut" bindtap="cutNumber">-</view>
            <input value="{{number}}" class="number" disabled="true" type="number" />
            <view class="add" bindtap="addNumber">+</view>
          </view>
        </view>
      </view>
      <view class="pop-bottom-btn">
        <view class="btn-add-cart {{soldout ? 'disabled' : ''}}" bindtap="{{soldout ? '' : 'addToCart'}}">加入购物车</view>
      </view>
    </view>
  </view>
</view>
