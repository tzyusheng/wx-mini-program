page {
  height: 100%;
}

.container {
  background: #f9f9f9;
  height: 100%;
  width: 100%;
  display: flex;
  flex-direction: column;
}

.search {
  height: 100rpx;
  width: 100%;
  padding: 0 30rpx;
  background: #fff;
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.search .input {
  width: 690rpx;
  height: 70rpx;
  border-radius: 20rpx;
  display: flex;
  padding-top: 18rpx;
  padding-left: 20rpx;
  align-items: left;
  vertical-align: middle;
  justify-content: left;
}

.search .icon {
  background: url('data:image/png;base64,') center no-repeat;
  background-size: 100%;
  width: 34rpx;
  height: 34rpx;
}

.search .txt {
  height: 42rpx;
  line-height: 42rpx;
  padding-left: 10rpx;
}

.catalog {
  flex: 1;
  width: 100%;
  background: #fff;
  display: flex;
  overflow: hidden;
}

.catalog .nav {
  width: 180rpx;
  height: 100%;
  background: #f4f4f4;
  flex-shrink: 0;
}

.catalog .nav .nav-item {
  text-align: center;
  line-height: 100rpx;
  width: 180rpx;
  height: 100rpx;
  color: #333;
  font-size: 28rpx;
  position: relative;
}

.catalog .nav .nav-item.active {
  color: #e67249;
  font-size: 30rpx;
  font-weight: bold;
  background: #fff;
  position: relative;
}

.catalog .nav .nav-item.active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 20rpx;
  width: 6rpx;
  height: 60rpx;
  background: #e67249;
  border-radius: 0 3rpx 3rpx 0;
}

.catalog .goods-area {
  flex: 1;
  height: 100%;
  background: #fff;
}

.catalog .goods-area.has-cart-bar {
  padding-bottom: 120rpx;
}

/* ========== 单列列表布局 ========== */
.goods-list {
  padding: 0 20rpx;
}

.goods-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.goods-item:last-child {
  border-bottom: none;
}

/* 左侧图片 */
.img-box {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: #f5f5f5;
}

.img-box .img {
  width: 100%;
  height: 100%;
}

/* 右侧信息区 */
.info-box {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding-left: 20rpx;
  min-height: 200rpx;
  min-width: 0;
}

.info-box .name {
  font-size: 28rpx;
  color: #333;
  line-height: 40rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 标签 */
.tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 10rpx;
}

.tag {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  margin-right: 10rpx;
  line-height: 32rpx;
}

.tag-hot {
  color: #fff;
  background: linear-gradient(135deg, #ff6b6b, #e64242);
}

.tag-new {
  color: #fff;
  background: linear-gradient(135deg, #6bc9ff, #42aee6);
}

/* 底部：价格 + 加入购物车 */
.bottom-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.bottom-row .price {
  font-size: 32rpx;
  font-weight: bold;
}

.btn-cart {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #e67249, #d45a2c);
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-cart-icon {
  font-size: 28rpx;
  color: #fff;
}

.loading-more,
.no-more {
  text-align: center;
  padding: 30rpx 0;
  font-size: 24rpx;
  color: #999;
}

/* ========== 规格选择弹窗 ========== */
.attr-pop-box {
  width: 100%;
  height: 100%;
  position: fixed;
  top: 0;
  left: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 8;
}

.attr-pop {
  width: 100%;
  max-height: 780rpx;
  padding: 31.25rpx;
  background: #fff;
  position: fixed;
  z-index: 9;
  bottom: 0;
  border-radius: 20rpx 20rpx 0 0;
  box-sizing: border-box;
  overflow-y: auto;
}

.attr-pop .close {
  position: absolute;
  width: 48rpx;
  height: 48rpx;
  right: 31.25rpx;
  top: 31.25rpx;
}

.attr-pop .close .icon {
  width: 48rpx;
  height: 48rpx;
}

.attr-pop .img-info {
  width: 100%;
  height: 177rpx;
  overflow: hidden;
  margin-bottom: 30rpx;
}

.attr-pop .img {
  float: left;
  height: 177rpx;
  width: 177rpx;
  background: #f4f4f4;
  margin-right: 31.25rpx;
  border-radius: 10rpx;
}

.attr-pop .info {
  float: left;
  height: 177rpx;
  display: flex;
  align-items: center;
}

.attr-pop .p {
  font-size: 33rpx;
  color: #e67249;
  height: 33rpx;
  line-height: 33rpx;
  margin-bottom: 10rpx;
}

.attr-pop .a {
  font-size: 26rpx;
  color: #666;
  height: 40rpx;
  line-height: 40rpx;
}

.spec-con {
  width: 100%;
  height: auto;
  overflow: hidden;
}

.spec-con .name {
  height: 32rpx;
  line-height: 32rpx;
  margin-bottom: 18rpx;
  font-size: 28rpx;
  color: #333;
}

.spec-con .values {
  height: auto;
  margin-bottom: 25rpx;
  font-size: 0;
}

.spec-con .value {
  display: inline-block;
  height: 62rpx;
  padding: 0 25rpx;
  line-height: 56rpx;
  text-align: center;
  margin-right: 20rpx;
  margin-bottom: 14rpx;
  border: 1px solid #999;
  border-radius: 6rpx;
  font-size: 25rpx;
  color: #999;
}

.spec-con .value.selected {
  border: 1px solid #e67249;
  color: #fff;
  background: #e67249;
}

.number-item .selnum {
  width: 280rpx;
  height: 68rpx;
  border: 1px solid #ccc;
  border-radius: 6rpx;
  display: flex;
  overflow: hidden;
}

.number-item .cut {
  width: 85rpx;
  height: 100%;
  text-align: center;
  line-height: 65rpx;
  font-size: 32rpx;
  color: #666;
}

.number-item .number {
  flex: 1;
  height: 100%;
  text-align: center;
  line-height: 65rpx;
  border-left: 1px solid #ccc;
  border-right: 1px solid #ccc;
  font-size: 26rpx;
}

.number-item .add {
  width: 85rpx;
  height: 100%;
  text-align: center;
  line-height: 65rpx;
  font-size: 32rpx;
  color: #666;
}

.pop-bottom-btn {
  margin-top: 30rpx;
  padding-bottom: 20rpx;
}

.btn-add-cart {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: linear-gradient(135deg, #e67249, #d45a2c);
  color: #fff;
  font-size: 30rpx;
  font-weight: bold;
  border-radius: 40rpx;
}

.btn-add-cart.disabled {
  background: #ccc;
  color: #999;
}

/* ========== 底部购物车栏 ========== */
.bottom-cart-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100rpx;
  background: #e67249;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  box-sizing: border-box;
  z-index: 7;
  justify-content: space-between;
}

.bottom-cart-icon-box {
  position: relative;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bottom-cart-icon {
  font-size: 48rpx;
  color: #fff;
}

.bottom-cart-count {
  position: absolute;
  top: 0;
  right: -4rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  background: #fff;
  color: #e67249;
  font-size: 20rpx;
  font-weight: bold;
  border-radius: 50%;
  padding: 0 4rpx;
  box-sizing: border-box;
}

.bottom-cart-text {
  flex: 1;
  color: #fff;
  font-size: 28rpx;
  padding-left: 20rpx;
}

.bottom-cart-arrow {
  font-size: 28rpx;
  color: #fff;
  opacity: 0.7;
}
